# App
NODE_ENV=development
PORT=4000

# Database (PostgreSQL via Supabase)
# Use the Supabase pooler URL for the app (port 6543 = transaction mode PgBouncer)
# connection_limit: max connections Prisma opens to PgBouncer (keep ≤ 5 on free tier)
# pool_timeout: seconds to wait for a free connection before throwing P2024 (fail fast)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=15"
# Direct connection for Prisma migrations (bypasses pooler)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Redis (Upstash)
# Get the ioredis-compatible URL from the Upstash dashboard: Connect -> ioredis tab
# Must start with rediss:// (not https://)
REDIS_URL="rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-at-least-64-hex-chars-long-use-crypto-randomBytes"
JWT_REFRESH_SECRET="change-me-different-from-access-secret-use-crypto-randomBytes"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_SECONDS=600

# WhatsApp (Meta Cloud API) — leave blank to use email fallback only
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="otp_verification"
WHATSAPP_OTP_TEMPLATE_LANG="en"

# Email OTP fallback (Gmail example — use an App Password, not your real password)
# Generate App Password: myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Esook <your-email@gmail.com>"

# CORS — comma-separated list of allowed origins
# In production, set this to your actual frontend URL(s)
CORS_ORIGINS="http://localhost:3000,http://localhost:4200"